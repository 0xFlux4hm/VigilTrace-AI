# AOBH environment — copy to .env and fill in; never commit the real file.
# Everything here can also be exported directly; env vars win over .env.

# --- engagement ---
ATAP_ENGAGEMENT_DIR=./engagement

# --- Burp bridge (the AI Agent Bridge extension, see docs/bridge-protocol.md) ---
BURP_BRIDGE_URL=http://127.0.0.1:8787
# >= 16 chars; without a token the bridge stays off
BURP_BRIDGE_TOKEN=
# "1" = direct-HTTP fallback for LOCAL LABS ONLY (flagged transport=direct)
ATAP_ALLOW_DIRECT=0

# --- ATAP account vault ---
# master key; if empty, a .vault_key file is created in the engagement dir
ATAP_VAULT_KEY=
ATAP_IMAP_HOST=
ATAP_IMAP_PORT=
ATAP_IMAP_USER=
ATAP_IMAP_PASS=
ATAP_IMAP_MAILBOX=
ATAP_MAILCATCH_PORT=8025

# --- RAG corpus ---
H1_INDEX_PATH=
H1_CSV_PATH=

# --- WAF / CAPTCHA budgets and solver service ---
WAF_PROBE_MAX=16
WAF_BYPASS_MAX=24
CAPTCHA_SERVICE_URL=https://2captcha.com
# unset means automated solving is OFF (human strategies only)
CAPTCHA_SERVICE_KEY=
CAPTCHA_MAX_SOLVES=5
